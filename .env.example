APP_NAME="AdGuard"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adguard
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=adguard_session
SESSION_SECURE=true
SESSION_SAMESITE=Lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/google/callback
GOOGLE_ADS_API_VERSION=v26
GOOGLE_ADS_WRITES_ENABLED=false

AUTO_BLOCK_ENABLED=false
AUTO_BLOCK_THRESHOLD=92
AUTO_BLOCK_MIN_EVENTS=8

TRUSTED_PROXIES=
VISIT_RETENTION_DAYS=90
LOG_LEVEL=warning