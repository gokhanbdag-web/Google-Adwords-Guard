Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Application source, configuration, migrations, templates and dependencies are never public.
    RewriteRule ^(?:app|config|database|docs|migrations|resources|routes|vendor)(?:/|$) - [F,L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Cross-Origin-Resource-Policy "same-site"
</IfModule>

<FilesMatch "^(?!index\\.php$).+\\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "^(?:composer\\.(?:json|lock)|schema\\.sql|seeders\\.sql|README\\.md)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\\.">
    Require all denied
</FilesMatch>
