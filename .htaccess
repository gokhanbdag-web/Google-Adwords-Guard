DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose application source, configuration, SQL, or environment files.
    RewriteRule ^(app|bootstrap|config|database|resources|routes|vendor)(/|$) - [F,L,NC]
    RewriteRule ^(\.env|composer\.(json|lock)|README\.md|schema\.sql|seeders\.sql)(/|$) - [F,L,NC]

    # Requests already targeting public assets or the public entry point stay there.
    RewriteRule ^public/ - [L]

    # Forward requests to the public directory when the host cannot set its document root.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
